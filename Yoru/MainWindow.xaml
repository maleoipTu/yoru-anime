<Window x:Class="Yoru.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Yoru — аниме для Windows" Width="1280" Height="860" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Icon="Assets/yoru.ico">
 <Grid x:Name="Root">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{StaticResource PanelGradient}" BorderBrush="#24242C" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="14,0,0,38">
     <StackPanel Orientation="Horizontal"><Image Source="Assets/yoru-256.png" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="yoru" FontSize="31" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="ТВОЙ ВЕЧЕР. ТВОЁ АНИМЕ." FontSize="9" Foreground="#848196" Margin="1,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="ProfileCard" Click="ProfileClick" Background="#1C1C23" Padding="12" Margin="0,0,0,20" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Профиль"><DockPanel><ContentControl x:Name="ProfileAvatar" DockPanel.Dock="Left" Width="44" Height="44" Focusable="False"/><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ProfileName" Text="Войти в аккаунт" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="ProfilePoints" Text="Очки и украшения профиля" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DockPanel></Button>
     <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="⚙    Настройки" Tag="settings" Checked="Navigate"/>
     <TextBlock Text="Yoru 0.4 · Windows" Foreground="#9990AA" FontSize="12" Margin="16,17,0,0"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="ОБЗОР" Foreground="#767286" FontSize="10" FontWeight="SemiBold" Margin="16,0,0,12"/>
     <RadioButton x:Name="CatalogNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="▦    Каталог" Tag="catalog" Checked="Navigate"/>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="◷    Расписание" Tag="schedule" Checked="Navigate"/>
     <TextBlock Text="МОЯ КОЛЛЕКЦИЯ" Foreground="#767286" FontSize="10" FontWeight="SemiBold" Margin="16,30,0,12"/>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="♡    Избранное" Tag="favorites" Checked="Navigate"/>
     <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="↺    История" Tag="history" Checked="Navigate"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="BrowseRoot" Grid.Column="1" Margin="32,26,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid MaxWidth="620" HorizontalAlignment="Stretch" Margin="0,0,22,0">
     <TextBox x:Name="SearchBox" Padding="37,12,85,12" BorderThickness="0" KeyDown="SearchKey" AutomationProperties.Name="Поиск аниме"/>
     <TextBlock Text="⌕" FontSize="24" Foreground="#8A8A96" Margin="12,1,0,0" IsHitTestVisible="False"/>
     <TextBlock x:Name="SearchHint" Text="Название аниме…" Foreground="#8E899E" Margin="38,12,80,0" IsHitTestVisible="False"/>
     <Button Content="Найти" Click="SearchClick" HorizontalAlignment="Right" Margin="4" Padding="12,4" FontSize="12"/>
     <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=SearchBox}"><Border Background="#16161B" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,6,12,16"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5"/></Border.Effect><StackPanel x:Name="SuggestList"/></Border></Popup>
    </Grid>
    <Border Grid.Column="1" CornerRadius="16" Background="#1F1F26" Padding="13,8" VerticalAlignment="Center"><TextBlock x:Name="ConnectionBadge" Text="○  Предпросмотр" Foreground="#FF8A9B" FontSize="12"/></Border>
   </Grid>
   <Border x:Name="PreviewBanner" Grid.Row="1" Background="#2A1A20" CornerRadius="10" Padding="14,11" Margin="0,0,0,20">
    <DockPanel><Button DockPanel.Dock="Right" Content="Подключить API  →" Padding="14,7" Style="{StaticResource Primary}" Click="SettingsClick" FontSize="12"/><TextBlock Text="Сейчас открыт предпросмотр. Добавь ключ YummyAnime, чтобы искать и смотреть." Foreground="#C9C9D2" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
   </Border>
   <ScrollViewer x:Name="BrowseScroll" Grid.Row="2">
    <StackPanel>
     <Border x:Name="ContinuePanel" Visibility="Collapsed" Background="#2A1A20" CornerRadius="14" Padding="20" Margin="0,0,0,20"><DockPanel><Button DockPanel.Dock="Right" Content="Продолжить →" Style="{StaticResource Primary}" Click="ContinueClick" VerticalAlignment="Center"/><StackPanel Margin="0,0,18,0"><TextBlock Text="ПРОДОЛЖИТЬ ПРОСМОТР" FontSize="11" Foreground="#FF9AA8"/><TextBlock x:Name="ContinueTitle" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,6"/><TextBlock x:Name="ContinueMeta" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel></Border>
     <Border x:Name="Hero" CornerRadius="18" Background="#24161B" Height="210" ClipToBounds="True" Margin="0,0,0,24">
      <Grid>
       <Image x:Name="HeroImage" HorizontalAlignment="Right" Width="540" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
       <Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#24161B" Offset="0"/><GradientStop Color="#F324161B" Offset="0.38"/><GradientStop Color="#B324161B" Offset="0.6"/><GradientStop Color="#1624161B" Offset="1"/></LinearGradientBrush></Border.Background></Border>
       <StackPanel Margin="24,19" HorizontalAlignment="Left" MaxWidth="440">
        <TextBlock Text="ИСТОРИЯ ДЛЯ ТВОЕГО ВЕЧЕРА" FontSize="11" FontWeight="Bold" Foreground="#FF8A9B" Margin="0,0,0,8"/>
        <TextBlock x:Name="HeroTitle" FontSize="25" FontWeight="Bold" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="HeroMeta" Foreground="#C9C9D2" FontSize="12" Margin="0,8,0,12"/>
        <TextBlock x:Name="HeroDescription" Visibility="Collapsed"/>
        <Button Content="Выбрать серию  →" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="21,10" Click="HeroClick"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Найди свою следующую историю" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Большие миры начинаются с одной серии" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="↻  Обновить" Click="RefreshClick" VerticalAlignment="Center" Padding="14,9"/></Grid>
     <StackPanel x:Name="Filters" Orientation="Horizontal" Margin="0,0,0,20">
      <ComboBox x:Name="ListPicker" Margin="0,0,12,0" SelectionChanged="ListChanged" AutomationProperties.Name="Список" Visibility="Collapsed"><ComboBoxItem Content="Избранное" Tag="" IsSelected="True"/><ComboBoxItem Content="Смотрю" Tag="watching"/><ComboBoxItem Content="Запланировано" Tag="planned"/><ComboBoxItem Content="Просмотрено" Tag="completed"/><ComboBoxItem Content="Брошено" Tag="dropped"/></ComboBox>
      <ComboBox x:Name="SortBox" SelectionChanged="FilterChanged" AutomationProperties.Name="Сортировка"><ComboBoxItem Content="По рейтингу" Tag="rating" IsSelected="True"/><ComboBoxItem Content="По популярности" Tag="views"/><ComboBoxItem Content="Сначала новые" Tag="year"/><ComboBoxItem Content="Случайный выбор" Tag="random"/></ComboBox>
      <ComboBox x:Name="StatusBox" Margin="12,0,12,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Статус аниме"><ComboBoxItem Content="Все статусы" Tag="" IsSelected="True"/><ComboBoxItem Content="Вышедшие" Tag="released"/><ComboBoxItem Content="Онгоинги" Tag="ongoing"/><ComboBoxItem Content="Анонсы" Tag="announcement"/></ComboBox>
      <Button x:Name="FilterButton" Content="⚲  Фильтры" Click="FiltersClick" Padding="14,9" Visibility="{Binding Visibility, ElementName=StatusBox}" AutomationProperties.Name="Фильтры по жанрам, годам и возрастному рейтингу"/>
      <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/>
     </StackPanel>
     <Border x:Name="EmptyState" Visibility="Collapsed" CornerRadius="14" Background="{StaticResource Panel}" Padding="40" Margin="0,8,0,18"><StackPanel><TextBlock Text="☾" FontSize="42" Foreground="#FF4D67" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border>
     <ItemsControl x:Name="Cards">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Width="172" Padding="0" Margin="0,0,16,23" Background="Transparent" HorizontalContentAlignment="Stretch" Click="CardClick" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
         <Border CornerRadius="12" Height="238" Background="#1F1F26" Effect="{StaticResource Shadow}"><Border CornerRadius="12" ClipToBounds="True"><Grid><Image Source="{Binding ImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="#D90E0E11" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="6" Padding="8,4" Margin="9"><TextBlock Text="{Binding Score}" FontSize="11" FontWeight="SemiBold" Foreground="#FFC14D"/></Border></Grid></Border></Border>
         <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="1,11,0,0" Height="40" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="1,5,0,0"/>
         <TextBlock Text="{Binding DisplayNote}" FontSize="12" Foreground="#FF8A9B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="1,5,0,0"/>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button x:Name="MoreButton" Content="Показать ещё" HorizontalAlignment="Center" Click="MoreClick" Margin="0,0,0,18" Visibility="Collapsed"/>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed">
    <StackPanel MaxWidth="690" HorizontalAlignment="Left" Margin="0,8,0,0">
     <TextBlock Text="Твой Yoru" FontSize="31" FontWeight="SemiBold"/>
     <TextBlock Text="YummyAnime уже подключён. Устройся поудобнее." Foreground="{StaticResource Muted}" Margin="0,10,0,27"/>
     <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="26"><StackPanel>
      <TextBlock Text="Подключение YummyAnime" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Публичный ключ приложения уже встроен — можно сразу искать и смотреть. При необходимости здесь можно указать другой ключ X-Application из кабинета разработчика YummyAnime." Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,13,0,18"/>
      <Button Content="Открыть кабинет разработчика  ↗" Click="DeveloperClick" HorizontalAlignment="Left" Margin="0,0,0,22"/>
      <TextBlock Text="Ключ приложения" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <PasswordBox x:Name="TokenBox" AutomationProperties.Name="Ключ приложения YummyAnime"/>
      <TextBlock Text="Если заменить ключ, его копия сохранится на этом ПК под защитой учётной записи Windows. Запросы отправляются напрямую в YummyAnime." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,20" LineHeight="20"/>
      <Button x:Name="ConnectButton" Content="Проверить и подключить" Style="{StaticResource Primary}" Click="ConnectClick" HorizontalAlignment="Left"/>
      <TextBlock x:Name="SettingsResult" TextWrapping="Wrap" Foreground="#C4B4F6" Margin="0,16,0,0"/>
     </StackPanel></Border>
     <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="26" Margin="0,18,0,0"><StackPanel>
      <TextBlock Text="Личная коллекция" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Избранное и последние открытые серии сохраняются локально, без входа в аккаунт. История помнит серию и озвучку; позицию внутри видео сохраняет сам плеер, если он это поддерживает." Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <TextBlock Text="Yoru — независимый клиент для личного использования. Доступность серий и работа видео зависят от YummyAnime и поставщика плеера. Для просмотра необходим Microsoft Edge WebView2 Runtime." Foreground="#898497" FontSize="12" LineHeight="20" Margin="2,22,0,20"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="0,12,0,0"><ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" Foreground="#FF4D67" Background="#1F1F26" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="" Foreground="#9C9CA8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <!-- Страницы внутри окна: карточка аниме, плеер, профиль, друзья, админка. -->
  <Grid x:Name="PageHost" Grid.Column="1" Visibility="Collapsed"/>
  <Border x:Name="UpdateBanner" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="18,14" CornerRadius="14" Background="#16161B" BorderBrush="#3A2028" BorderThickness="1" Effect="{StaticResource Shadow}">
   <StackPanel Orientation="Horizontal"><StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="UpdateTitle" Text="Доступно обновление" FontWeight="SemiBold"/><TextBlock x:Name="UpdateText" Foreground="#9C9CA8" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="UpdateButton" Content="Обновить" Style="{StaticResource Primary}" Click="UpdateClick"/><Button Content="Позже" Margin="8,0,0,0" Click="UpdateLaterClick"/></StackPanel>
  </Border>
  <ContentControl x:Name="AuthHost" Grid.ColumnSpan="2" Visibility="Collapsed" Focusable="False"/>
 </Grid>
</Window>
