<Window x:Class="Yoru.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Yoru — аниме для Windows" Width="1280" Height="860" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Icon="Assets/yoru.ico">
 <Grid x:Name="Root">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="Transparent">
   <Grid>
    <!-- Фон панели без перегородки: панель, небо и звёзды плавно растворяются вправо в фон окна (#0E0E11). -->
    <Grid IsHitTestVisible="False" OpacityMask="{StaticResource SideFade}">
     <Rectangle Fill="{StaticResource PanelGradient}"/>
     <!-- Ночное небо над логотипом: мягкий фиолетовый отсвет и звёзды, растворяющиеся книзу. -->
     <Rectangle Height="280" VerticalAlignment="Top"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1B1528" Offset="0"/><GradientStop Color="#001B1528" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle Height="280" VerticalAlignment="Top" Fill="{StaticResource StarField}"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
    </Grid>
    <DockPanel Margin="20,32,20,24">
     <StackPanel DockPanel.Dock="Top" Margin="16,0,0,44">
      <StackPanel Orientation="Horizontal"><Image Source="Assets/yoru-256.png" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="yoru" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
      <TextBlock Text="Твой вечер. Твоё аниме." FontSize="12" Foreground="#8E8AA0" Margin="2,10,0,0"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="ProfileCard" Click="ProfileClick" Background="#1C1C23" BorderBrush="#2A2A33" BorderThickness="1" Padding="14" Margin="0,0,0,16" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Профиль"><DockPanel><ContentControl x:Name="ProfileAvatar" DockPanel.Dock="Left" Width="44" Height="44" Focusable="False"/><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ProfileName" Text="Войти в аккаунт" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="ProfilePoints" Text="Очки и украшения профиля" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DockPanel></Button>
      <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="⚙    Настройки" Tag="settings" Checked="Navigate"/>
      <TextBlock Text="Yoru 0.5 · Windows" Foreground="#7E7A90" FontSize="12" Margin="18,16,0,0"/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="Обзор" Foreground="#77738A" FontSize="12" FontWeight="SemiBold" Margin="18,0,0,10"/>
      <RadioButton x:Name="CatalogNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="▦    Каталог" Tag="catalog" Checked="Navigate"/>
      <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="◷    Расписание" Tag="schedule" Checked="Navigate"/>
      <TextBlock Text="Моя коллекция" Foreground="#77738A" FontSize="12" FontWeight="SemiBold" Margin="18,32,0,10"/>
      <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="♡    Избранное" Tag="favorites" Checked="Navigate"/>
      <RadioButton GroupName="Navigation" Style="{StaticResource Nav}" Content="↺    История" Tag="history" Checked="Navigate"/>
     </StackPanel>
    </DockPanel>
   </Grid>
  </Border>
  <Grid x:Name="BrowseRoot" Grid.Column="1" Margin="40,32,40,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,28">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid MaxWidth="640" HorizontalAlignment="Stretch" Margin="0,0,24,0">
     <TextBox x:Name="SearchBox" Padding="46,13,100,13" KeyDown="SearchKey" AutomationProperties.Name="Поиск аниме"/>
     <TextBlock Text="⌕" FontSize="24" Foreground="#8A8A96" Margin="16,0,0,3" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <TextBlock x:Name="SearchHint" Text="Название аниме…" Foreground="#8E899E" Margin="48,0,96,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Button Content="Найти" Click="SearchClick" HorizontalAlignment="Right" Margin="6" Padding="18,6" FontSize="12"/>
     <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=SearchBox}"><Border Background="#16161B" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="16" Padding="8" Margin="0,8,12,16"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.5"/></Border.Effect><StackPanel x:Name="SuggestList"/></Border></Popup>
    </Grid>
    <Border Grid.Column="1" CornerRadius="18" Background="#1C1C23" BorderBrush="#2A2A33" BorderThickness="1" Padding="16,10" VerticalAlignment="Center"><TextBlock x:Name="ConnectionBadge" Text="○  Предпросмотр" Foreground="#FF8A9B" FontSize="12"/></Border>
   </Grid>
   <Border x:Name="PreviewBanner" Grid.Row="1" Background="#2A1A20" BorderBrush="#3A2028" BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="0,0,0,28">
    <DockPanel><Button DockPanel.Dock="Right" Content="Подключить API  →" Padding="18,9" Style="{StaticResource Primary}" Click="SettingsClick" FontSize="12"/><TextBlock Text="Сейчас открыт предпросмотр. Добавь ключ YummyAnime, чтобы искать и смотреть." Foreground="#C9C9D2" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
   </Border>
   <ScrollViewer x:Name="BrowseScroll" Grid.Row="2" ScrollChanged="BrowseScrolled">
    <StackPanel Margin="0,0,12,0">
     <Border x:Name="ContinuePanel" Visibility="Collapsed" Background="{StaticResource DuskPanel}" BorderBrush="#3A2028" BorderThickness="1" CornerRadius="20" Padding="28,24" Margin="0,0,0,40"><DockPanel><Button DockPanel.Dock="Right" Content="Продолжить →" Style="{StaticResource Primary}" Padding="24,13" Click="ContinueClick" VerticalAlignment="Center"/><StackPanel Margin="0,0,24,0"><TextBlock Text="Продолжить просмотр" FontSize="12" FontWeight="SemiBold" Foreground="#FF9AA8"/><TextBlock x:Name="ContinueTitle" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock x:Name="ContinueMeta" FontSize="13" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel></Border>
     <Border x:Name="Hero" CornerRadius="24" Background="#1C1426" BorderBrush="#2A2033" BorderThickness="1" Height="264" ClipToBounds="True" Margin="0,0,0,40">
      <Grid>
       <Image x:Name="HeroImage" HorizontalAlignment="Right" Width="560" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
       <Border CornerRadius="23"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#1C1426" Offset="0"/><GradientStop Color="#F31C1426" Offset="0.4"/><GradientStop Color="#B31C1426" Offset="0.62"/><GradientStop Color="#141C1426" Offset="1"/></LinearGradientBrush></Border.Background></Border>
       <!-- Звёзды над текстом и «заря» у нижнего края: герой — ночное небо перед сеансом. -->
       <Rectangle Fill="{StaticResource StarField}" RadiusX="23" RadiusY="23" IsHitTestVisible="False" Opacity="0.8"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.55"/></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
       <Border CornerRadius="23" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0.12,1.15" GradientOrigin="0.12,1.15" RadiusX="0.55" RadiusY="0.9"><GradientStop Color="#55FF4D67" Offset="0"/><GradientStop Color="#18FF8A3D" Offset="0.55"/><GradientStop Color="#00FF8A3D" Offset="1"/></RadialGradientBrush></Border.Background></Border>
       <StackPanel Margin="36,32" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="480">
        <TextBlock Text="История для твоего вечера" FontSize="13" FontWeight="SemiBold" Foreground="#FF8A9B" Margin="0,0,0,10"/>
        <TextBlock x:Name="HeroTitle" FontSize="30" FontWeight="Bold" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="HeroMeta" Foreground="#C9C9D2" FontSize="13" Margin="0,10,0,20"/>
        <TextBlock x:Name="HeroDescription" Visibility="Collapsed"/>
        <Button Content="Выбрать серию  →" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="24,13" Click="HeroClick"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Найди свою следующую историю" Style="{StaticResource PageTitle}"/><Border Style="{StaticResource Dawn}"/><TextBlock x:Name="PageSubtitle" Text="Большие миры начинаются с одной серии" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="↻  Обновить" Click="RefreshClick" VerticalAlignment="Center" Padding="18,12"/></Grid>
     <StackPanel x:Name="Filters" Orientation="Horizontal" Margin="0,0,0,32">
      <ComboBox x:Name="ListPicker" Margin="0,0,12,0" SelectionChanged="ListChanged" AutomationProperties.Name="Список" Visibility="Collapsed"><ComboBoxItem Content="Избранное" Tag="" IsSelected="True"/><ComboBoxItem Content="Смотрю" Tag="watching"/><ComboBoxItem Content="Запланировано" Tag="planned"/><ComboBoxItem Content="Просмотрено" Tag="completed"/><ComboBoxItem Content="Отложено" Tag="on_hold"/><ComboBoxItem Content="Брошено" Tag="dropped"/></ComboBox>
      <ComboBox x:Name="SortBox" SelectionChanged="FilterChanged" AutomationProperties.Name="Сортировка"><ComboBoxItem Content="Случайные" Tag="random" IsSelected="True"/><ComboBoxItem Content="По рейтингу" Tag="rating"/><ComboBoxItem Content="По популярности" Tag="views"/><ComboBoxItem Content="Сначала новые" Tag="year"/></ComboBox>
      <ComboBox x:Name="StatusBox" Margin="12,0,12,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Статус аниме"><ComboBoxItem Content="Все статусы" Tag="" IsSelected="True"/><ComboBoxItem Content="Вышедшие" Tag="released"/><ComboBoxItem Content="Онгоинги" Tag="ongoing"/><ComboBoxItem Content="Анонсы" Tag="announcement"/></ComboBox>
      <Button x:Name="FilterButton" Content="⚲  Фильтры" Click="FiltersClick" Padding="18,12" Visibility="{Binding Visibility, ElementName=StatusBox}" AutomationProperties.Name="Фильтры по жанрам, годам и возрастному рейтингу"/>
      <Button Content="🎲  Рулетка" Click="RouletteClick" Padding="18,12" Margin="12,0,0,0" AutomationProperties.Name="Случайное аниме"/>
      <Button Content="✨  Для тебя" Click="ForYouClick" Padding="18,12" Margin="12,0,0,0" AutomationProperties.Name="Рекомендации для тебя"/>
      <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12"/>
     </StackPanel>
     <Border x:Name="EmptyState" Visibility="Collapsed" Style="{StaticResource Section}" Padding="48" Margin="0,8,0,24"><StackPanel><TextBlock Text="☾" FontSize="48" Foreground="#FF4D67" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0"/></StackPanel></Border>
     <ItemsControl x:Name="Cards">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button x:Name="Card" Style="{StaticResource CatalogCard}" Width="180" Margin="0,8,24,36" Click="CardClick" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
         <Border x:Name="Poster" CornerRadius="14" Height="252" Background="#1F1F26" BorderBrush="#1FFFFFFF" BorderThickness="1" Effect="{StaticResource Shadow}"><Grid><Grid.Clip><RectangleGeometry Rect="0,0,178,250" RadiusX="13" RadiusY="13"/></Grid.Clip><Image Source="{Binding ImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="#D90E0E11" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="8" Padding="8,4" Margin="10"><TextBlock Text="{Binding Score}" FontSize="11" FontWeight="SemiBold" Foreground="#FFC14D"/></Border></Grid></Border>
         <TextBlock x:Name="CardTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="2,14,0,0" Height="42" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="2,6,0,0"/>
         <TextBlock Text="{Binding DisplayNote}" FontSize="12" Foreground="#FF8A9B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="2,6,0,0"/>
        </StackPanel>
       </Button>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
         <Setter TargetName="Poster" Property="Effect" Value="{StaticResource CardGlow}"/>
         <Setter TargetName="Poster" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
         <Setter TargetName="CardTitle" Property="Foreground" Value="#FFB3C1"/>
        </DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button x:Name="MoreButton" Content="Показать ещё" HorizontalAlignment="Center" Click="MoreClick" Padding="28,12" Margin="0,8,0,24" Visibility="Collapsed"/>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,8,12,0">
     <TextBlock Text="Твой Yoru" Style="{StaticResource PageTitle}"/>
     <Border Style="{StaticResource Dawn}"/>
     <TextBlock Text="YummyAnime уже подключён. Устройся поудобнее." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,14,0,32"/>
     <Border Style="{StaticResource Section}"><StackPanel>
      <TextBlock Text="Подключение YummyAnime" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Публичный ключ приложения уже встроен — можно сразу искать и смотреть. При необходимости здесь можно указать другой ключ X-Application из кабинета разработчика YummyAnime." Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,14,0,20"/>
      <Button Content="Открыть кабинет разработчика  ↗" Click="DeveloperClick" HorizontalAlignment="Left" Margin="0,0,0,28"/>
      <TextBlock Text="Ключ приложения" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <PasswordBox x:Name="TokenBox" AutomationProperties.Name="Ключ приложения YummyAnime"/>
      <TextBlock Text="Если заменить ключ, его копия сохранится на этом ПК под защитой учётной записи Windows. Запросы отправляются напрямую в YummyAnime." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,24" LineHeight="20"/>
      <Button x:Name="ConnectButton" Content="Проверить и подключить" Style="{StaticResource Primary}" Click="ConnectClick" HorizontalAlignment="Left"/>
      <TextBlock x:Name="SettingsResult" TextWrapping="Wrap" Foreground="#C4B4F6" Margin="0,16,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}" Margin="0,24,0,0"><StackPanel>
      <TextBlock Text="Уведомления и Discord" Style="{StaticResource SectionTitle}"/>
      <CheckBox x:Name="NotifyBox" Content="Сообщать о новых сериях аниме из «Смотрю» и избранного" Foreground="#F5F5F7" Margin="0,18,0,0" Click="SocialSettingsChanged"/>
      <CheckBox x:Name="DiscordBox" Content="Показывать в Discord, что я смотрю" Foreground="#F5F5F7" Margin="0,14,0,0" Click="SocialSettingsChanged"/>
      <Border Height="1" Background="#24242C" Margin="0,24,0,20"/>
      <TextBlock Text="Discord Application ID" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBox x:Name="DiscordIdBox" MaxLength="22" AutomationProperties.Name="Discord Application ID" LostFocus="SocialSettingsChanged"/>
      <TextBlock Text="Создай приложение «Yoru» на discord.com/developers/applications и вставь сюда его Application ID. Discord должен быть запущен на этом ПК." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Section}" Margin="0,24,0,0"><StackPanel>
      <TextBlock Text="Личная коллекция" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Избранное и последние открытые серии сохраняются локально, без входа в аккаунт. История помнит серию и озвучку; позицию внутри видео сохраняет сам плеер, если он это поддерживает." Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,14,0,0"/>
     </StackPanel></Border>
     <TextBlock Text="Yoru — независимый клиент для личного использования. Доступность серий и работа видео зависят от YummyAnime и поставщика плеера. Для просмотра необходим Microsoft Edge WebView2 Runtime." Foreground="#898497" FontSize="12" LineHeight="20" Margin="4,28,0,24"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="0,12,0,0"><ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" Foreground="#FF4D67" Background="#1F1F26" BorderThickness="0" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="" Foreground="#9C9CA8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <!-- Страницы внутри окна: карточка аниме, плеер, профиль, друзья, админка. -->
  <Grid x:Name="PageHost" Grid.Column="1" Visibility="Collapsed"/>
  <Border x:Name="UpdateBanner" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="32" Padding="20,16" CornerRadius="18" Background="#16161B" BorderBrush="#3A2028" BorderThickness="1" Effect="{StaticResource Shadow}">
   <StackPanel Orientation="Horizontal"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock x:Name="UpdateTitle" Text="Доступно обновление" FontWeight="SemiBold"/><TextBlock x:Name="UpdateText" Foreground="#9C9CA8" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="UpdateButton" Content="Обновить" Style="{StaticResource Primary}" Click="UpdateClick"/><Button Content="Позже" Margin="12,0,0,0" Click="UpdateLaterClick"/></StackPanel>
  </Border>
  <ContentControl x:Name="AuthHost" Grid.ColumnSpan="2" Visibility="Collapsed" Focusable="False"/>
 </Grid>
</Window>
