<UserControl x:Class="Yoru.DetailPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="40,32,40,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#252131" Height="168" CornerRadius="16" Effect="{StaticResource Shadow}"><Grid><Grid.Clip><RectangleGeometry Rect="0,0,120,168" RadiusX="16" RadiusY="16"/></Grid.Clip><Image x:Name="PosterImage" Stretch="UniformToFill"/></Grid></Border>
   <StackPanel Grid.Column="1" Margin="28,0,0,4" VerticalAlignment="Bottom"><TextBlock Text="Аниме" FontSize="13" Foreground="#FF8A9B" FontWeight="SemiBold"/><TextBlock x:Name="AnimeTitle" FontSize="32" FontWeight="SemiBold" MaxHeight="86" TextTrimming="CharacterEllipsis" Margin="0,8,0,12"/><WrapPanel><TextBlock x:Name="ScoreText" Foreground="#FFC14D" FontWeight="SemiBold" FontSize="14" Margin="0,0,20,0"/><TextBlock x:Name="MetaText" Foreground="{StaticResource Muted}" FontSize="14"/></WrapPanel></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{StaticResource DuskPanel}" BorderBrush="#3A2028" BorderThickness="1" CornerRadius="20" Padding="28" Margin="0,32,0,32"><StackPanel>
   <DockPanel><TextBlock Text="Выбери, как смотреть" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="VideoStatus" Foreground="{StaticResource Muted}" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"/></DockPanel>
   <Grid x:Name="Selectors" Margin="0,20,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Озвучка" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox x:Name="TrackBox" MinWidth="0" MaxDropDownHeight="280" SelectionChanged="TrackChanged" AutomationProperties.Name="Озвучка"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Плеер" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox x:Name="ProviderBox" MinWidth="0" MaxDropDownHeight="240" SelectionChanged="ProviderChanged" AutomationProperties.Name="Плеер"/></StackPanel>
    <StackPanel Grid.Column="2" Visibility="Collapsed"><TextBlock Text="Серия" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox x:Name="EpisodeBox" MinWidth="0" MaxDropDownHeight="280" DisplayMemberPath="Label" SelectionChanged="EpisodeChanged" AutomationProperties.Name="Серия"/></StackPanel>
   </Grid>
   <StackPanel x:Name="EpisodesSection" Margin="0,24,0,0" Visibility="Collapsed"><DockPanel Margin="0,0,0,12"><TextBlock Text="Серии" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="WatchedText" Foreground="{StaticResource Muted}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/></DockPanel><ScrollViewer MaxHeight="146"><ContentControl x:Name="EpisodeTiles" Focusable="False" Margin="0,4,0,0"/></ScrollViewer></StackPanel>
   <DockPanel Margin="0,24,0,0"><Button x:Name="WatchButton" Content="▶  Смотреть" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="32,14" Click="WatchClick" Visibility="Collapsed"/><TextBlock Text="Озвучку и плеер можно поменять во время просмотра." Foreground="{StaticResource Muted}" FontSize="12" Margin="20,0,0,0" VerticalAlignment="Center"/></DockPanel>
   <Button x:Name="SetupButton" Content="Подключить API" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed" Click="SetupClick"/>
   <Button x:Name="RetryButton" Content="Повторить загрузку" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed" Click="RetryClick"/>
  </StackPanel></Border>
  <ScrollViewer Grid.Row="2"><StackPanel x:Name="ScrollBody" Margin="0,0,12,0">
   <TextBlock x:Name="GenresText" Foreground="#FF9AA8" FontSize="14" Margin="0,0,0,14"/>
   <WrapPanel x:Name="StudioChips" Margin="0,0,0,16"/>
   <TextBlock Text="О чём эта история" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
   <TextBlock x:Name="DescriptionText" Foreground="#C9C9D2" FontSize="15" LineHeight="24" MaxHeight="96" TextTrimming="CharacterEllipsis" MaxWidth="820" HorizontalAlignment="Left"/>
   <Button x:Name="ExpandButton" Content="Развернуть описание ↓" Background="Transparent" Foreground="#FF8A9B" Padding="0,12" Click="ExpandClick" HorizontalAlignment="Left"/>
   <TextBlock x:Name="AgeText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
   <ContentControl x:Name="FranchiseHost" Focusable="False"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="#24242C" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0"><DockPanel><StackPanel Orientation="Horizontal"><Button x:Name="FavoriteButton" Click="FavoriteClick"/><Button Content="Открыть на сайте ↗" Margin="12,0,0,0" Click="SiteClick"/></StackPanel><Button Content="Закрыть" HorizontalAlignment="Right" IsCancel="True" Click="CloseClick"/></DockPanel></Border>
 </Grid>
</UserControl>
