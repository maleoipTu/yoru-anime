<Application x:Class="Yoru.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <!-- Токены дизайна — см. docs/design.md. Отступы 4/8/12/16/24/32/48, радиусы 8/12/20/24. -->
  <SolidColorBrush x:Key="Muted" Color="#9C9CA8" />
  <SolidColorBrush x:Key="Accent" Color="#FF4D67" />
  <SolidColorBrush x:Key="Panel" Color="#16161B" />
  <SolidColorBrush x:Key="Raised" Color="#1F1F26" />
  <SolidColorBrush x:Key="Line" Color="#2A2A33" />
  <SolidColorBrush x:Key="HairLine" Color="#24242C" />
  <Style TargetType="Window"><Setter Property="Background" Value="#0E0E11"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <SolidColorBrush x:Key="ButtonBackground" Color="#1F1F26"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF4D67" Offset="0"/><GradientStop Color="#FF8A3D" Offset="1"/></LinearGradientBrush>
  <!-- «Заря»: горизонтальная полоса под заголовком страницы и метка активного раздела. -->
  <LinearGradientBrush x:Key="DawnLine" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF4D67" Offset="0"/><GradientStop Color="#FF8A3D" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1C1C23" Offset="0"/><GradientStop Color="#141418" Offset="1"/></LinearGradientBrush>
  <!-- Подложка секции: едва тёплый верхний левый угол, уходящий в обычную панель. -->
  <LinearGradientBrush x:Key="SectionGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1E1A22" Offset="0"/><GradientStop Color="#17171C" Offset="0.45"/><GradientStop Color="#141418" Offset="1"/></LinearGradientBrush>
  <!-- Ночное небо для шапок и тёплая «заря» для акцентных панелей. -->
  <LinearGradientBrush x:Key="NightSky" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1B1528" Offset="0"/><GradientStop Color="#15121E" Offset="0.5"/><GradientStop Color="#141418" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="DuskPanel" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2E1622" Offset="0"/><GradientStop Color="#21141E" Offset="0.5"/><GradientStop Color="#18141C" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="NavActive" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#3A1820" Offset="0"/><GradientStop Color="#1A3A1820" Offset="1"/></LinearGradientBrush>
  <!-- Звёздное поле: повторяющаяся плитка с точками разной яркости. Только для шапок. -->
  <DrawingBrush x:Key="StarField" TileMode="Tile" Viewport="0,0,240,170" ViewportUnits="Absolute" Viewbox="0,0,240,170" ViewboxUnits="Absolute" Stretch="None">
   <DrawingBrush.Drawing>
    <DrawingGroup>
     <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,240,170"/></GeometryDrawing.Geometry></GeometryDrawing>
     <GeometryDrawing Brush="#B8FFFFFF"><GeometryDrawing.Geometry><GeometryGroup>
      <EllipseGeometry Center="22,18" RadiusX="1.1" RadiusY="1.1"/><EllipseGeometry Center="171,41" RadiusX="1.2" RadiusY="1.2"/><EllipseGeometry Center="96,128" RadiusX="1" RadiusY="1"/>
     </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
     <GeometryDrawing Brush="#66FFFFFF"><GeometryDrawing.Geometry><GeometryGroup>
      <EllipseGeometry Center="63,52" RadiusX="0.8" RadiusY="0.8"/><EllipseGeometry Center="129,14" RadiusX="0.7" RadiusY="0.7"/><EllipseGeometry Center="214,102" RadiusX="0.8" RadiusY="0.8"/>
      <EllipseGeometry Center="37,146" RadiusX="0.7" RadiusY="0.7"/><EllipseGeometry Center="152,88" RadiusX="0.6" RadiusY="0.6"/>
     </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
     <GeometryDrawing Brush="#40FFD9C2"><GeometryDrawing.Geometry><GeometryGroup>
      <EllipseGeometry Center="198,152" RadiusX="0.9" RadiusY="0.9"/><EllipseGeometry Center="8,92" RadiusX="0.6" RadiusY="0.6"/><EllipseGeometry Center="118,63" RadiusX="0.5" RadiusY="0.5"/>
     </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup>
   </DrawingBrush.Drawing>
  </DrawingBrush>
  <DropShadowEffect x:Key="Shadow" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
  <DropShadowEffect x:Key="AccentGlow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#FF4D67"/>
  <DropShadowEffect x:Key="AccentGlowStrong" BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.7" Color="#FF4D67"/>
  <DropShadowEffect x:Key="CardGlow" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#FF4D67"/>
  <DropShadowEffect x:Key="DawnGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#FF4D67"/>

  <!-- Типографика: заголовок страницы, секции, подписи. -->
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#9C9CA8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <!-- Полоса «зари» под заголовком страницы. -->
  <Style x:Key="Dawn" TargetType="Border"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="3"/><Setter Property="CornerRadius" Value="1.5"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Background" Value="{StaticResource DawnLine}"/><Setter Property="Effect" Value="{StaticResource DawnGlow}"/></Style>
  <!-- Секция: панель с лёгким градиентом, радиус 20, внутри 28. -->
  <Style x:Key="Section" TargetType="Border"><Setter Property="Background" Value="{StaticResource SectionGradient}"/><Setter Property="BorderBrush" Value="#24242C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="28"/></Style>

  <Style x:Key="Chip" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#1F1F26"/><Setter Property="BorderBrush" Value="#2A2A33"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#4A2A34"/><Setter TargetName="Body" Property="Background" Value="#24242C"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="#3A1820"/><Setter TargetName="Body" Property="BorderBrush" Value="#FF4D67"/><Setter Property="Foreground" Value="#FF8A9B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="#FF4D67" BorderThickness="2" CornerRadius="14" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <!-- Кнопка: высота ~44, радиус 12; наведение — светлая вуаль, нажатие — лёгкое сжатие. -->
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
   <Setter Property="Background" Value="#1F1F26"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
     <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/>
     <Border x:Name="Veil" Background="#FFFFFF" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.07"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.11"/><Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Effect" Value="{StaticResource AccentGlow}"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Effect" Value="{StaticResource AccentGlowStrong}"/></Trigger></Style.Triggers>
  </Style>
  <!-- Карточка каталога: при наведении приподнимается; постер подсвечивается в шаблоне данных. -->
  <Style x:Key="CatalogCard" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Lift" Background="Transparent"><Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-6" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Lift" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Пункт боковой навигации: активный — подложка, уходящая в прозрачность, и полоса «зари» слева. -->
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#9C9CA8"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid>
    <Border x:Name="Bg" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"/>
    <Border x:Name="Mark" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource DawnLine}" Effect="{StaticResource DawnGlow}" Opacity="0"/>
    <ContentPresenter Margin="{TemplateBinding Padding}"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1D1D24"/><Setter Property="Foreground" Value="#D8D8E0"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActive}"/><Setter TargetName="Mark" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#FFB3C1"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#FF4D67"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Поля ввода: радиус 12, высота ~44, светлее при наведении, акцентная обводка в фокусе. -->
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#1F1F26"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="CaretBrush" Value="#FF8A9B"/><Setter Property="BorderBrush" Value="#2A2A33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,12"/><Setter Property="SelectionBrush" Value="#B23A4C"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#3A3A46"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FF4D67"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="#1F1F26"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="CaretBrush" Value="#FF8A9B"/><Setter Property="BorderBrush" Value="#2A2A33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,12"/><Setter Property="SelectionBrush" Value="#B23A4C"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#3A3A46"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FF4D67"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBody" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#2A2A33"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#4A1A26"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinWidth" Value="168"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#1F1F26"/><Setter Property="BorderBrush" Value="#2A2A33"/><Setter Property="MaxDropDownHeight" Value="280"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="FieldBody" Background="{Binding Background,RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush,RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="12"><TextBlock Text="⌄" Foreground="#9C9CA8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,4"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldBody" Property="BorderBrush" Value="#FF4D67"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="14,8,34,8" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#16161B" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,6,12,16" Effect="{StaticResource Shadow}" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FF4D67"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Флажки в стиле Yoru: скруглённый квадрат, при включении — акцентный градиент с галочкой. -->
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="10,0,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Grid Width="22" Height="22" VerticalAlignment="Center">
      <Border x:Name="Box" CornerRadius="7" Background="#1F1F26" BorderBrush="#3A3A46" BorderThickness="1.5"/>
      <Border x:Name="Fill" CornerRadius="7" Background="{StaticResource AccentGradient}" Opacity="0"/>
      <Path x:Name="Tick" Data="M6,11.5 L9.5,15 L16,7.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
     </Grid>
     <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="1"/><Setter TargetName="Tick" Property="Opacity" Value="1"/><Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FF8A9B"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FF4D67"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <!-- Тонкая полоса прокрутки без фона: заметнее при наведении и перетаскивании. -->
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#34343F" CornerRadius="4" Margin="3,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#4A4A58"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#7A3A48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
