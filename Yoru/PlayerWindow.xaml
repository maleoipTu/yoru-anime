<Window x:Class="Yoru.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Style="{StaticResource {x:Type Window}}" Title="Просмотр · Yoru" Width="1220" Height="790" MinWidth="850" MinHeight="570" WindowStartupLocation="CenterOwner" Background="#08080D" PreviewKeyDown="PlayerKey">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PlayerHeader" Margin="22,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="ShowTitle" FontSize="18" FontWeight="SemiBold" MaxHeight="52" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Полный экран · F11" Click="FullScreenClick" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SidebarColumn" Width="270"/></Grid.ColumnDefinitions>
   <Grid x:Name="VideoSurface"><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#08080D"/><Border x:Name="PlayerMessage" Background="#15121F" Visibility="Collapsed" Padding="32"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><TextBlock Text="Не удалось открыть видео" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="ErrorText" TextAlignment="Center" FontSize="14" LineHeight="24" Margin="0,16,0,0"/><Button Content="Повторить" Click="RetryClick" HorizontalAlignment="Center" Margin="0,20,0,0"/><Button x:Name="RuntimeButton" Content="Установить WebView2 ↗" Click="RuntimeClick" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/></StackPanel></Border></Grid>
   <Border x:Name="PlayerSidebar" Grid.Column="1" Background="#17141F" BorderBrush="#2D2739" BorderThickness="1,0,0,0" Padding="20"><ScrollViewer><StackPanel>
    <TextBlock Text="Сейчас смотришь" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,22"/>
    <TextBlock Text="Озвучка" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="VoiceBox" MinWidth="0" MaxDropDownHeight="270" SelectionChanged="VoiceChanged" AutomationProperties.Name="Озвучка"/>
    <TextBlock Text="Плеер" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,7"/><ComboBox x:Name="SourceBox" MinWidth="0" MaxDropDownHeight="220" SelectionChanged="SourceChanged" AutomationProperties.Name="Плеер"/>
    <TextBlock Text="Серия" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,7"/><ComboBox x:Name="SeriesBox" MinWidth="0" MaxDropDownHeight="270" DisplayMemberPath="Label" AutomationProperties.Name="Серия"/>
    <Button x:Name="ApplyButton" Content="▶  Смотреть выбранное" Style="{StaticResource Primary}" Click="ApplyClick" Margin="0,20,0,0" Padding="10,12"/>
    <TextBlock x:Name="SelectionHint" FontSize="12" Foreground="#C4B2EE" LineHeight="19" Margin="0,10,0,0"/>
    <Border Height="1" Background="#332B40" Margin="0,25,0,21"/>
    <TextBlock Text="Видео не запускается?" FontSize="14" FontWeight="SemiBold"/>
    <TextBlock Text="Переключим текущую серию на другой плеер с той же озвучкой, если он доступен." FontSize="12" Foreground="{StaticResource Muted}" LineHeight="20" Margin="0,9,0,13"/>
    <Button x:Name="AlternativeButton" Content="Другой плеер →" Click="AlternativeClick" Padding="10,11"/>
    <Button Content="↻  Повторить загрузку" Click="RetryClick" Padding="10,11" Margin="0,10,0,0"/>
    <Button Content="←  К карточке аниме" Click="BackClick" Background="Transparent" Foreground="#C4B2FF" Padding="6,12" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid x:Name="PlayerFooter" Grid.Row="2" Margin="20,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PreviousButton" Content="←  Предыдущая" Click="PreviousClick"/><TextBlock Grid.Column="1" x:Name="PlayerStatus" Text="Загружаем плеер…" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15,0"/><Button Grid.Column="2" x:Name="NextButton" Content="Следующая  →" Click="NextClick" Style="{StaticResource Primary}"/></Grid>
 </Grid>
</Window>
