<Window x:Class="Yoru.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Профиль · Yoru" Width="900" Height="820" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
 <Grid Margin="28,24,28,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="CloseClick"/>
   <StackPanel><TextBlock Text="☾  ПРОФИЛЬ YORU" FontSize="11" FontWeight="SemiBold" Foreground="#C4B2FF"/><TextBlock x:Name="Heading" Text="Твой профиль" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <ScrollViewer x:Name="Scroll" Grid.Row="1"><StackPanel x:Name="Body" Margin="0,0,10,10"/></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,10,0,0"><ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" Foreground="#B3A2FF" Background="#23202D" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Foreground="#FF9A8B" FontSize="12" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</Window>
