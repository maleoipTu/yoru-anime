<UserControl x:Class="Yoru.ProfilePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True">
 <Grid Margin="40,32,40,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,28">
   <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="CloseClick" VerticalAlignment="Top"/>
   <StackPanel><TextBlock Text="☾  Профиль Yoru" FontSize="13" FontWeight="SemiBold" Foreground="#FF8A9B"/><TextBlock x:Name="Heading" Text="Твой профиль" Style="{StaticResource PageTitle}" Margin="0,8,0,0"/><Border Style="{StaticResource Dawn}"/></StackPanel>
  </DockPanel>
  <ScrollViewer x:Name="Scroll" Grid.Row="1"><StackPanel x:Name="Body" Margin="0,0,12,12"/></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" Foreground="#FF4D67" Background="#1F1F26" BorderThickness="0" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Foreground="#FF9A8B" FontSize="12" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</UserControl>
