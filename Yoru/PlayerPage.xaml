<UserControl x:Class="Yoru.PlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Background="#08080D" PreviewKeyDown="PlayerKey">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PlayerHeader" Margin="28,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock x:Name="ShowTitle" FontSize="20" FontWeight="SemiBold" MaxHeight="56" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackLabel" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Полный экран · F11" Click="FullScreenClick" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SidebarColumn" Width="340"/></Grid.ColumnDefinitions>
   <Grid x:Name="VideoSurface"><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#08080D"/><Border x:Name="PlayerMessage" Background="{StaticResource NightSky}" Visibility="Collapsed" Padding="40"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><TextBlock Text="☾" FontSize="44" Foreground="#FF4D67" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="Не удалось открыть видео" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="ErrorText" TextAlignment="Center" FontSize="14" LineHeight="24" Margin="0,16,0,0"/><Button Content="Повторить" Click="RetryClick" HorizontalAlignment="Center" Margin="0,24,0,0"/><Button x:Name="RuntimeButton" Content="Установить WebView2 ↗" Click="RuntimeClick" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/></StackPanel></Border></Grid>
   <Grid x:Name="PlayerSidebar" Grid.Column="1"><!-- Без перегородки: левый край панели мягко растворяется в тёмный фон плеера. --><Rectangle Fill="{StaticResource PanelGradient}" OpacityMask="{StaticResource SideFadeLeft}" IsHitTestVisible="False"/><Border Padding="24,24,16,24"><DockPanel><UniformGrid x:Name="SidebarTabs" DockPanel.Dock="Top" Rows="1" Margin="0,0,8,24"/><ScrollViewer x:Name="SidebarScroll"><StackPanel x:Name="SettingsPanel" Margin="0,0,8,0">
    <TextBlock Text="Сейчас смотришь" Style="{StaticResource SectionTitle}" Margin="0,0,0,20"/>
    <TextBlock Text="Озвучка" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="VoiceBox" MinWidth="0" MaxDropDownHeight="270" SelectionChanged="VoiceChanged" AutomationProperties.Name="Озвучка"/>
    <TextBlock Text="Плеер" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,8"/><ComboBox x:Name="SourceBox" MinWidth="0" MaxDropDownHeight="220" SelectionChanged="SourceChanged" AutomationProperties.Name="Плеер"/>
    <TextBlock Text="Серия" Visibility="Collapsed"/><ComboBox Visibility="Collapsed" x:Name="SeriesBox" MinWidth="0" MaxDropDownHeight="270" DisplayMemberPath="Label" AutomationProperties.Name="Серия"/>
    <Button x:Name="ApplyButton" Content="▶  Смотреть с этой озвучкой" Style="{StaticResource Primary}" Click="ApplyClick" Margin="0,24,0,0" Padding="12,14"/>
    <TextBlock x:Name="SelectionHint" FontSize="12" Foreground="#FF9AA8" LineHeight="19" Margin="0,12,0,0"/>
    <DockPanel Margin="0,28,0,12"><TextBlock Text="Серии" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PlayerWatchedText" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/></DockPanel>
    <ContentControl x:Name="PlayerEpisodes" Focusable="False"/>
    <Border Height="1" Background="#24242C" Margin="0,28,0,24"/>
    <TextBlock Text="Видео не запускается?" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="Переключим текущую серию на другой плеер с той же озвучкой, если он доступен." FontSize="12" Foreground="{StaticResource Muted}" LineHeight="20" Margin="0,10,0,16"/>
    <Button x:Name="AlternativeButton" Content="Другой плеер →" Click="AlternativeClick" Padding="12,12"/>
    <Button x:Name="SiteButton" Content="Плеер Yoru ⇄ плеер сайта" Click="SiteClick" Padding="12,12" Margin="0,12,0,0" ToolTip="Kodik открывается в плеере Yoru без рекламы. Плеер сайта — запасной вариант, в нём может быть реклама."/>
    <Button Content="↻  Повторить загрузку" Click="RetryClick" Padding="12,12" Margin="0,12,0,0"/>
    <Button Content="←  К карточке аниме" Click="BackClick" Background="Transparent" Foreground="#FF8A9B" Padding="6,12" Margin="0,16,0,0"/>
   </StackPanel></ScrollViewer></DockPanel></Border></Grid>
  </Grid>
  <Grid x:Name="PlayerFooter" Grid.Row="2" Margin="28,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PreviousButton" Content="←  Предыдущая" Click="PreviousClick"/><TextBlock Grid.Column="1" x:Name="PlayerStatus" Text="Загружаем плеер…" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0"/><Button Grid.Column="2" x:Name="NextButton" Content="Следующая  →" Click="NextClick" Style="{StaticResource Primary}"/></Grid>
 </Grid>
</UserControl>
