<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yoru</AssemblyName>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\yoru.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- WinForms нужен только для значка в трее (уведомления о новых сериях); его пространства имён не подключаются глобально. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    <Resource Include="Assets\yoru.ico" />
    <Resource Include="Assets\yoru-256.png" />
    <Content Include="Assets\**\*" Exclude="Assets\PlayerHost\hls.min.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\PlayerHost\hls.min.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\supabase.properties" Link="supabase.properties" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\supabase.properties')" />
  </ItemGroup>
  <!-- hls.js (Apache-2.0) для нативного плеера: скачивается при первой сборке фиксированной версии. -->
  <PropertyGroup><HlsJsVersion>1.5.17</HlsJsVersion></PropertyGroup>
  <Target Name="FetchHlsJs" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\PlayerHost\hls.min.js')">
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/hls.js@$(HlsJsVersion)/dist/hls.min.js" DestinationFolder="$(MSBuildProjectDirectory)\Assets\PlayerHost" Retries="3" />
  </Target>
</Project>
